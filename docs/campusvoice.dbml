// CampusVoice database — paste this into dbdiagram.io
// City of Malabon University · SASO

Project CampusVoice {
  database_type: 'MySQL'
  Note: 'Concern management system for the Student Affairs and Service Office (SASO)'
}

// ---------- People and offices ----------

Table departments {
  department_id int [pk, increment]
  department_name varchar(150) [not null, unique]
  department_type enum_department_type [not null, default: 'college']
}

Table users {
  user_id int [pk, increment]
  role enum_role [not null, default: 'student']
  school_id varchar(30) [not null, unique, note: 'username']
  first_name varchar(80) [not null]
  middle_initial char(2)
  last_name varchar(80) [not null]
  email varchar(190) [unique]
  password_hash varchar(255) [not null]
  department_id int [ref: > departments.department_id]
  position varchar(120)
  contact_number varchar(30)
  course varchar(60)
  year_level tinyint
  section varchar(20)
  avatar varchar(255)
  availability enum_availability [not null, default: 'available']
  account_status enum_account_status [not null, default: 'active']
  must_change_password boolean [not null, default: false]
  pref_notify_inapp boolean [not null, default: true]
  pref_notify_email boolean [not null, default: true]
  pref_default_anonymous boolean [not null, default: false]
  google_sub varchar(64) [unique]
  google_email varchar(190)
  google_linked_at datetime
  last_login_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

// ---------- Concern types and places ----------

Table categories {
  category_id int [pk, increment]
  category_name varchar(100) [not null, unique]
  description varchar(255)
  default_department_id int [ref: > departments.department_id]
  needs_location boolean [not null, default: false]
  next_steps varchar(500)
  status enum_active [not null, default: 'active']
}

Table category_handlers {
  category_id int [ref: > categories.category_id]
  staff_id int [ref: > users.user_id]
  indexes {
    (category_id, staff_id) [pk]
  }
  Note: 'The owner (staff) of each concern type'
}

Table locations {
  location_id int [pk, increment]
  building varchar(100) [not null]
  floor varchar(40) [not null]
  area varchar(100) [not null]
  status enum_active [not null, default: 'active']
  indexes {
    (building, floor, area) [unique]
  }
}

// ---------- Concerns ----------

Table concerns {
  concern_id int [pk, increment]
  concern_code varchar(20) [not null, unique]
  student_id int [not null, ref: > users.user_id]
  category_id int [not null, ref: > categories.category_id]
  location_id int [ref: > locations.location_id]
  severity enum_severity [not null, default: 'Minor']
  status enum_concern_status [not null, default: 'Submitted']
  title varchar(150) [not null]
  description text [not null]
  is_anonymous boolean [not null, default: false]
  wants_meeting boolean [not null, default: false]
  meeting_pref varchar(120)
  due_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  resolved_at datetime
  closed_at datetime
}

// ---------- Concern activity ----------

Table assignments {
  assignment_id int [pk, increment]
  concern_id int [not null, ref: > concerns.concern_id]
  staff_id int [not null, ref: > users.user_id]
  assigned_by int [ref: > users.user_id, note: 'NULL = routed automatically']
  assigned_at datetime [not null, default: `now()`]
  assignment_status enum_assignment_status [not null, default: 'active']
  reason varchar(255)
  seen_at datetime
  completed_at datetime
}

Table visits {
  visit_id int [pk, increment]
  concern_id int [not null, ref: > concerns.concern_id]
  scheduled_by int [ref: > users.user_id]
  scheduled_at datetime [not null]
  place varchar(120) [not null, default: 'SASO Office']
  note varchar(255)
  status enum_visit_status [not null, default: 'scheduled']
  student_note varchar(255)
  outcome_note varchar(255)
  responded_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table concern_updates {
  update_id int [pk, increment]
  concern_id int [not null, ref: > concerns.concern_id]
  user_id int [ref: > users.user_id, note: 'NULL = system']
  status varchar(30)
  update_type varchar(60) [not null]
  response text
  created_at datetime [not null, default: `now()`]
}

Table photos {
  photo_id int [pk, increment]
  concern_id int [not null, ref: > concerns.concern_id]
  uploaded_by int [not null, ref: > users.user_id]
  photo_type enum_photo_type [not null, default: 'supporting']
  file_path varchar(255) [not null]
  created_at datetime [not null, default: `now()`]
}

Table feedback {
  feedback_id int [pk, increment]
  concern_id int [not null, unique, ref: - concerns.concern_id]
  student_id int [not null, ref: > users.user_id]
  rating tinyint [not null, note: '1 to 5']
  comment varchar(500)
  created_at datetime [not null, default: `now()`]
}

Table notifications {
  notification_id int [pk, increment]
  user_id int [not null, ref: > users.user_id]
  concern_id int [ref: > concerns.concern_id]
  title varchar(150) [not null]
  message varchar(500) [not null]
  is_urgent boolean [not null, default: false]
  is_read boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]
}

// ---------- Security ----------

Table login_attempts {
  attempt_id int [pk, increment]
  email varchar(190) [not null, note: 'username or email tried']
  ip_address varchar(45) [not null]
  success boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]
}

Table password_resets {
  reset_id int [pk, increment]
  user_id int [not null, ref: > users.user_id]
  token_hash char(64) [not null]
  expires_at datetime [not null]
  used_at datetime
  created_at datetime [not null, default: `now()`]
}

Table audit_logs {
  log_id int [pk, increment]
  user_id int [note: 'no link on purpose: logs survive user deletion']
  user_label varchar(190) [not null]
  role varchar(20) [not null]
  action varchar(60) [not null]
  details varchar(500)
  ip_address varchar(45) [not null]
  created_at datetime [not null, default: `now()`]
}

// ---------- System ----------

Table settings {
  setting_key varchar(60) [pk]
  setting_value varchar(255) [not null]
}

Table working_hours {
  day_of_week tinyint [pk, note: '0 = Sunday']
  open_time time
  close_time time
  active boolean [not null, default: true]
}

Table events {
  event_id int [pk, increment]
  title varchar(150) [not null]
  start_at datetime [not null]
  end_at datetime
  notes varchar(255)
  created_by int [ref: > users.user_id]
}

// ---------- Enums ----------

Enum enum_department_type {
  college
  work_area
  administration
}

Enum enum_role {
  student
  staff
  admin
}

Enum enum_availability {
  available
  busy
  on_leave
}

Enum enum_account_status {
  active
  inactive
  suspended
}

Enum enum_active {
  active
  inactive
}

Enum enum_severity {
  Minor
  Major
  Urgent
}

Enum enum_concern_status {
  Submitted
  Pending
  "Under Review"
  "Additional Info Needed"
  Assigned
  "In Progress"
  "Waiting for Resources"
  Resolved
  Reopened
  Closed
  Cancelled
}

Enum enum_assignment_status {
  active
  reassigned
  completed
}

Enum enum_visit_status {
  scheduled
  confirmed
  reschedule
  attended
  no_show
  cancelled
}

Enum enum_photo_type {
  supporting
  before
  after
}

// ---------- Groups (colour boxes in dbdiagram) ----------

TableGroup people {
  departments
  users
}

TableGroup concern_types {
  categories
  category_handlers
  locations
}

TableGroup concern_activity {
  concerns
  assignments
  visits
  concern_updates
  photos
  feedback
  notifications
}

TableGroup security_and_system {
  login_attempts
  password_resets
  audit_logs
  settings
  working_hours
  events
}
